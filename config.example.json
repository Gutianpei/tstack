{
  "user": "you",
  "workspace": "~/work",
  "memory_dir": "~/tstack-memory",
  "data_dir": "~/tstack-data",
  "bin_dir": "~/.local/bin",
  "agent": {
    "cmd": "claude",
    "herdr_kind": "claude",
    "manager_model": "opus",
    "worker_model": "sonnet",
    "model_flag": "--model",
    "name_flag": "-n",
    "extra_args": [],
    "exit_command": "/exit",
    "idle_states": ["idle", "done"],
    "context_regex": "(?i)context left until auto-compact:\\s*(\\d+(?:\\.\\d+)?)%",
    "context_reports": "left",
    "start_timeout_ms": 60000
  },
  "swarm": {
    "overall": "overall",
    "managers": {},
    "max_workers": 4
  },
  "server": {
    "scratch_dir": "",
    "ckpts_dir": "",
    "worktree_root": "",
    "gpu_backend": "nvidia-smi",
    "gpu_command": "nvidia-smi",
    "gpu_locks": {},
    "gpu_busy_mib": 1024,
    "reserve_max_hours": 72,
    "disk_min_free_gb": 20,
    "disk_paths": []
  },
  "routine": {
    "backend": "auto",
    "session": "tstack-routine",
    "interval_seconds": 60,
    "morning_restart": "06:00",
    "context_restart_percent": 60,
    "check_every_minutes": 10,
    "quiet_minutes": 10,
    "context_source": "auto",
    "transcript_dir": "~/.claude/projects",
    "context_window_tokens": 200000,
    "question_regex": "Enter to select|Esc to cancel|Do you want to (proceed|make this edit|create)",
    "say_wait_minutes": 10,
    "herdr_notices": true,
    "pilot_log": true,
    "scheduled_prompts": [],
    "disk_alert": {"enabled": true, "agent": "", "every_hours": 24},
    "night": {
      "session": "tstack-night",
      "backend": "auto",
      "window_start": "22:00",
      "window_end": "07:00",
      "headless_args": ["-p", "--output-format", "json"],
      "extra_args": ["--permission-mode", "acceptEdits"],
      "resume_flag": "--resume",
      "model": "",
      "max_attempts": 3,
      "job_minutes": 120,
      "report_to": "",
      "cwd": ""
    }
  },
  "slack": {
    "channel": "",
    "allowed_users": [],
    "token_file": "~/.config/tstack/slack-token",
    "api_base": "https://slack.com/api",
    "backend": "webapi",
    "poll_seconds": 10,
    "notices": "bridge",
    "say_wait_minutes": 30,
    "runner": "nohup"
  },
  "upkeep": {
    "backend": "disk",
    "disk_path": "~/tstack-backups",
    "s3_uri": "",
    "aws_profile": "",
    "backup_time": "03:00",
    "roots": [],
    "skip": [".cache", "*_cache", ".venv*", "venv", "site-packages", "node_modules", "__pycache__"],
    "protected": [],
    "min_size_mb": 0,
    "max_file_mb": 512,
    "upload_files": true,
    "files_cap_gib": 20,
    "keep_daily": 7,
    "keep_weekly": 4,
    "prune": true,
    "weekly_day": "sun",
    "review_owner": "",
    "runner": "auto",
    "history_dir": "~/.claude/projects"
  }
}
